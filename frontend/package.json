{
  "name": "ediscovery-frontend",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "npm run check:undefined",
    "check:undefined": "node scripts/check-undefined.mjs",
    "build": "npm run check:undefined && vite build",
    "preview": "vite preview --host",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --debug"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-modal": "^3.16.3",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@vitejs/plugin-react": "^5.1.2",
    "vite": "^6.4.3"
  }
}
